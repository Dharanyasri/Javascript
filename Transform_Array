/*
 * Return a new array where each number is multiplied by 5.
 */
const numbers = [1, 3, 5, 7];

// Expected Output: [5, 15, 25, 35]

//Method 1
let result=[];
for(let i=0;i<numbers.length;i++){
  result[result.length]=numbers[i]*5;
}
console.log(result);

//Method 2
let result=[];
let i=0;
while(i<numbers.length){
  result[result.length]=numbers[i]*5;
  i++;
}
console.log(result);

//Method 3
let result=numbers.map(numbers=>numbers*5);
console.log(result);
