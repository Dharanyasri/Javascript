/*
 * Remove Duplicate Numbers from an Array
 *
 * Return a new array containing only unique
 * numbers while maintaining their original order.
 */

const numbers = [10, 20, 10, 30, 20, 40, 50, 30];

// Expected Output: [10, 20, 30, 40, 50]

let result=[];
for(let i=0;i<numbers.length;i++){
let flag=false;
  for(let j=0;j<result.length;j++){
    if(numbers[i]==result[j]){
      flag=true;
      break;
    }
  }
  if(flag===false){
    result[result.length]=numbers[i];
  }
}
console.log(result);
