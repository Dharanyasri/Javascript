//Calculate each customer's total successful credit and debit amounts.
const result = transactions
    .filter(trs => trs.status === "success")
    .reduce((acc, trs) => {
        if (!acc[trs.customer]) {
            acc[trs.customer] = {
                totalCredit: 0,
                totalDebit: 0
            };
        }

        if (trs.type === "credit") {
            acc[trs.customer].totalCredit += trs.amount;
        } else if (trs.type === "debit") {
            acc[trs.customer].totalDebit += trs.amount;
        }

        return acc;
    }, {});

