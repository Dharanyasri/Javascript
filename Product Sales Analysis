/*
 * Product Sales Analysis
 *
 * - [ ] 1. Get only Electronics products.
 *
 * - [ ] 2. Calculate the revenue for each Electronics product.
 *       revenue = price × sold
 *
 * - [ ] 3. Keep only the product name and revenue.
 *
 * - [ ] 4. Sort the products by revenue from highest to lowest.
 *
 * - [ ] 5. Calculate the total revenue of all Electronics products.
 *
 * - [ ] 6. Find the Electronics product with the highest revenue.
 *
 * - [ ] 7. Generate the final result in this format:
 *
 * {
 *     products: [
 *         { name: "...", revenue: ... },
 *         { name: "...", revenue: ... },
 *         { name: "...", revenue: ... }
 *     ],
 *     totalRevenue: ...,
 *     highestRevenueProduct: "..."
 * }
 */

const products = [
    { name: "Laptop", category: "Electronics", price: 50000, sold: 3 },
    { name: "Mouse", category: "Electronics", price: 1000, sold: 10 },
    { name: "Chair", category: "Furniture", price: 5000, sold: 4 },
    { name: "Keyboard", category: "Electronics", price: 3000, sold: 5 },
    { name: "Desk", category: "Furniture", price: 8000, sold: 2 }
];

const elect = products.filter(prd=>prd.category=="Electronics");
const revn = elect.map(rv=>{
    const revenue = rv.price*rv.sold;
    return {
        name : rv.name,
        revenue : revenue
    }
})
const sorting = revn.sort((g,h)=>h.revenue-g.revenue);
const whole = sorting.reduce((acc,sum)=>acc+sum.revenue,0);
const incre = revn.reduce((highest,item)=>{
    return (highest.revenue>item.revenue) ? highest : item;
}).name;
const result = {
    products : revn,
    totalRevenue : whole,
    highestRevenueProduct : incre
}
console.log(result);
