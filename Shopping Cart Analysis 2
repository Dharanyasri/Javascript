//Shopping Cart Analysis
const cart = [
    { id: 1, name: "Laptop", category: "Electronics", price: 55000, quantity: 1, discount: 10 },
    { id: 2, name: "Headphones", category: "Electronics", price: 2000, quantity: 2, discount: 5 },
    { id: 3, name: "T-Shirt", category: "Clothing", price: 800, quantity: 3, discount: 0 },
    { id: 4, name: "Shoes", category: "Footwear", price: 2500, quantity: 1, discount: 15 },
    { id: 5, name: "Watch", category: "Accessories", price: 3000, quantity: 2, discount: 10 },
    { id: 6, name: "Jeans", category: "Clothing", price: 1800, quantity: 2, discount: 5 },
    { id: 7, name: "Keyboard", category: "Electronics", price: 1500, quantity: 1, discount: 0 }
];

/*
Get all products belonging to the "Electronics" category.
Find the product named "Shoes".
Create an array containing only the product names.
Check whether any product has a discount greater than 10%.
Check whether every product has a quantity greater than 0.
Calculate the total number of items in the cart, counting quantities.
Calculate the total price before discounts.
Calculate the final cart total after applying each product's discount.
Sort products by price from lowest to highest.
Find the most expensive product.
Get all products whose final price after discount is below ₹2,000 per unit.
Create an array of unique product categories.
*/

//Get all products belonging to the "Electronics" category.
const a = cart.filter(c=>c.category=="Electronics");
console.log(a);

//Find the product named "Shoes".
const b = cart.filter(c=>c.name=="Shoes");
console.log(b);

//Create an array containing only the product names.
const c = cart.map(c=>c.name);
console.log(c);

//Check whether any product has a discount greater than 10%.
const d = cart.some(c=>c.discount>10);
console.log(d);

//Check whether every product has a quantity greater than 0.
const e = cart.every(c=>c.quantity>0);
console.log(e);

//Calculate the total number of items in the cart, counting quantities.
const f = cart.reduce((acc,item)=>{
  if(!acc[item.name]){
    acc[item.name]=0;
  }
  acc[item.name]++;
  return acc;
},{});
console.log(f);

//Calculate the total price before discounts.
const g = cart.reduce((acc,sum)=>{
  return acc+sum.price*sum.quantity;
},0);
console.log(g);

//Calculate the final cart total after applying each product's discount.
const h = cart.reduce((acc,sum)=>{
  return acc+sum.price*sum.quantity*sum.discount/100;
},0);
console.log(h);

//Sort products by price from lowest to highest.
const i = cart.sort((x,y)=>y.price-x.price);
console.log(i);

//Find the most expensive product.
const j = cart.reduce((high,item)=>{
  return high.name>item.name ? high : item;
});
console.log(j); 
