/*
 * Return a new array containing only the names
 * of products whose price is greater than 1000.
 */
const products = [
  { name: "Mouse", price: 500 },
  { name: "Keyboard", price: 1200 },
  { name: "Monitor", price: 8000 },
  { name: "Pen", price: 50 }
];

// Expected Output: ["Keyboard", "Monitor"]

//Method 1
const result=[];
for(let i=0;i<products.length;i++){
  if(products[i].price>1000){
    result[result.length]=products[i].name;
  }
}
console.log(result);

//Method 2
const result=[];
let i=0;
while(i<products.length){
    if(products[i].price>1000){
    result[result.length]=products[i].name;
  }
   i++;
}
console.log(result);

//Method 3
const result=products.filter(products=>products.price>1000)
                      .map(products=>products.name);
console.log(result);
